<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.Kafka" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\deploy\sql\init.sql" Link="sql\init.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deploy\sql\migrate.sh" Link="sql\migrate.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deploy\sql\migrations\*.sql" Link="sql\migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deploy\transformations\**\*" Link="transformations\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deploy\grafana\**\*" Link="grafana\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Telemetrix.Edge.Bridge\appsettings*.json"
          Link="config\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Telemetrix.MqttSim\Telemetrix.MqttSim.csproj" />
    <ProjectReference Include="..\..\src\Telemetrix.Edge.Bridge\Telemetrix.Edge.Bridge.csproj" />
    <ProjectReference Include="..\..\src\Telemetrix.Transformer\Telemetrix.Transformer.csproj" />
    <ProjectReference Include="..\..\src\Telemetrix.PlantSim\Telemetrix.PlantSim.csproj" />
  </ItemGroup>

</Project>
