# Copy to deploy/.env (git-ignored) and fill in. Never commit real values (NFR-10).
POSTGRES_PASSWORD=change-me
# Enable only after reviewing and explicitly applying deploy/sql/migrations/.
PLANT_EVENTS_ENABLED=false
# Optional: host computer DNS name for .NET OPC UA clients through localhost/NAT.
# Set before first certificate creation; changing it requires explicit rotation.
# OPCUA_HOST_NAME=your-computer-name
