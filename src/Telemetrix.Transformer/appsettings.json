{
  "PlantEvents": {
    "Enabled": false
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092"
  },
  "TagResolution": {
    "UnknownTagPolicy": "dead-letter"
  },
  "Transformations": {
    "Enabled": false,
    "Directory": "transformations",
    "TimeoutMs": 2000,
    "MaxOutputSamples": 10000,
    "MemoryLimitMb": 512
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
